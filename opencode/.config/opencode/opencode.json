{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest",
    "./plugins/superpowers/.opencode/plugins/superpowers.js",
    "opencode-sessions-explorer"
  ],
  "server": {
    "port": 3011,
    "hostname": "0.0.0.0"
  },
  "model": "github-copilot/claude-sonnet-5",
  "small_model": "github-copilot/gpt-5-mini",
  "lsp": true,
  "formatter": true,
  "share": "disabled",
  "provider": {
    "anthropic": {
      "models": {},
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "google": {
      "options": {
        "projectId": "{env:GOOGLE_CLOUD_PROJECT_ID}"
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        "gemma4:e4b": {
          "name": "gemma4:e4b",
          "limit": {
            "context": 32786,
            "output": 4096
          }
        }
      }
    }
  },
  "mcp": {
    "openmemory": {
      "enabled": true,
      "type": "remote",
      "url": "{env:OM_URL}/mcp",
      "headers": {
        "X-API-Key": "ABC"
      }
    }
  },
  "permission": {
   "external_directory": {
      "/tmp/**": "allow",
      "~/.local/share/opencode/**": "allow"
    },
    "edit": {
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git add *": "deny",
      "rm *": "ask"
    }
  }
}
