unbind r
bind r source-file ~/.tmux.conf
set -g prefix C-s
set -g mouse on
set -g allow-passthrough on
set-option -g focus-events on
set-option -a terminal-features 'xterm:RGB'
set-option -g status-position top

bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'egel/tmux-gruvbox'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'joshmedeski/tmux-nerd-font-window-name'
set -g @plugin 'sainnhe/tmux-fzf'

set -g @tmux-gruvbox 'dark'
set -g @tmux-gruvbox-left-status-a '#S'
set -g @tmux-gruvbox-statusbar-alpha 'true'
set -g @tmux-gruvbox-right-status-z '#{cpu_percentage}   #h '

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf).
# Guarded so a fresh machine/container without TPM installed doesn't error out.
if-shell "test -f ~/.tmux/plugins/tpm/tpm" "run '~/.tmux/plugins/tpm/tpm'"
